  m_Script: {fileID: 11500000, guid: 260d0c1b73a47764cb818a9857c1aba8, type: 3}
  m_Name: Day1Vietnamese
  m_EditorClassIdentifier: 
  _arrival:
  - key: day1.polly.arrival.1
    vietnamese: "Ch\xE0o b\xE1c s\u0129... T\xF4i b\u1ECB \u0111au \u0111\u1EA7u
      m\u1EA5y h\xF4m nay r\u1ED3i."
  - key: day1.polly.arrival.2
    vietnamese: "C\xF4ng vi\u1EC7c nhi\u1EC1u qu\xE1, ng\xE0y n\xE0o t\xF4i c\u0169ng
      ph\u1EA3i t\u0103ng ca."
  - key: day1.polly.arrival.3
    vietnamese: "T\u1ED1i qua t\xF4i g\u1EA7n nh\u01B0 kh\xF4ng ng\u1EE7 \u0111\u01B0\u1EE3c.
      \u0110\u1EA7u c\u1EE9 \u0111au li\xEAn t\u1EE5c..."
  _examination:
  - key: day1.polly.examination.1
    vietnamese: "B\xE1c s\u0129 ki\u1EC3m tra gi\xFAp t\xF4i v\u1EDBi. T\xF4i m\u1EC7t
      qu\xE1 r\u1ED3i."
  - key: day1.polly.examination.2
    vietnamese: "Kh\xF4ng bi\u1EBFt c\xF3 nghi\xEAm tr\u1ECDng kh\xF4ng n\u1EEFa..."
  _recovery:
  - key: day1.polly.recovery.1
    vietnamese: "\xD4i, d\u1EC5 ch\u1ECBu h\u01A1n nhi\u1EC1u r\u1ED3i! C\u1EA3m
      \u01A1n b\xE1c s\u0129 nh\xE9!"
  - key: day1.polly.recovery.2
    vietnamese: "Ch\u1EAFc t\xF4i ph\u1EA3i xin ngh\u1EC9 ph\xE9p v\xE0i h\xF4m th\xF4i."
  _mupple:
  - key: day1.muple.welcome
    vietnamese: "\xC0, c\u1EADu l\xE0 nh\xE2n vi\xEAn m\u1EDBi \u0111\u01B0\u1EE3c
      tuy\u1EC3n d\u1EE5ng \u0111\xFAng kh\xF4ng? Ch\xE0o m\u1EEBng \u0111\u1EBFn
      v\u1EDBi b\u1EC7nh vi\u1EC7n!"
  - key: day1.muple.first_day
    vietnamese: "Ng\xE0y \u0111\u1EA7u l\xE0m vi\u1EC7c th\u1EBF n\xE0o? Ch\u1EAFc
      c\u0169ng kh\xF4ng qu\xE1 kh\xF3 nh\u1EC9?"
  - key: day1.muple.one_more_thing
    vietnamese: "\xC0, c\xF2n m\u1ED9t \u0111i\u1EC1u n\u1EEFa..."
  - key: day1.muple.warning
    vietnamese: "N\u1EBFu m\u1ECDi th\u1EE9 tr\u1EDF n\xEAn k\u1EF3 l\u1EA1, h\xE3y
      c\u1EE9 ti\u1EBFp t\u1EE5c l\xE0m vi\u1EC7c."
  - key: day1.muple.shutter
    vietnamese: "H\xE3y nh\u1EA5n v\xE0o n\xFAt Shutter \u0111\u1EC3 t\u1EEB ch\u1ED1i
      v\u1ECB kh\xE1ch b\u1EA5t th\u01B0\u1EDDng"
  - key: day1.muple.goodbye
    vietnamese: "Th\xF4i, ch\xFAc c\u1EADu m\u1ED9t ca tr\u1EF1c t\u1ED1t l\xE0nh!"
